---
import { site } from '../content/site';
import { asset, href } from '../lib/url';
import '../styles/riso.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.lead } = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — ${site.owner}`;

const nav = [
  { label: 'главная', path: '/' },
  { label: 'о сайте', path: '/about' },
];

const here = Astro.url.pathname.replace(/\/+$/, '');
const isCurrent = (path: string) => href(path).replace(/\/+$/, '') === here;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#F3EDE0" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body class="grain">
    <a class="skip" href="#main">к содержимому</a>

    <header class="top">
      <div class="wrap top__row">
        <a class="brand" href={href('/')}>
          {site.title}
          <span class="brand__dot">{site.owner}</span>
        </a>
        <nav aria-label="разделы сайта">
          <ul class="nav">
            {nav.map((item) => (
              <li>
                <a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot__row">
        <span>{site.title} · {site.owner}</span>
        <span>{site.footer}</span>
      </div>
    </footer>
  </body>
</html>
