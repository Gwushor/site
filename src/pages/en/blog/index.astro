---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogListView from '../../../components/BlogListView.astro';
import { content } from '../../../content';

const seo = content.en.meta.pages.blog;
---

<BaseLayout lang="en" path="/blog" title={seo.title} description={seo.description} alternates={{ ru: '/blog', en: '/en/blog' }}>
  <BlogListView lang="en" />
</BaseLayout>
